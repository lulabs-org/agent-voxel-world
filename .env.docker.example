# Docker 部署环境变量配置示例

# 端口配置
WEB_PORT=80
POSTGRES_PORT=55432

# 数据库配置
POSTGRES_USER=voxel
POSTGRES_PASSWORD=voxelpassword
POSTGRES_DB=voxel

# 跨域设置（默认 * 允许任意 IP 或域名访问）
WEB_ORIGIN=*

# 实时语音实验协议；Agent TTS 在控制台选择 Piper 等服务
VOICE_PROVIDER=mock

# 共享 Speaches：Whisper ASR + Piper TTS
SPEECH_PORT=8000
# SPEECH_API_URL=http://speech:8000/v1
# WHISPER_API_URL=  # ASR 独立覆盖
# PIPER_API_URL=    # TTS 独立覆盖
# 旧 WHISPER_PORT 和网络名 whisper 仍兼容；模型卷不变。

# 可选：DeepSeek AI 配置
# DEEPSEEK_API_KEY=your-api-key
# DEEPSEEK_MODEL=deepseek-flash

# 可选：本地 Ollama（如果在宿主机运行 Ollama，可配置 host.docker.internal:11434）
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
