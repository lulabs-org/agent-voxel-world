{
  "name": "agent-voxel-world",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.6.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --filter @voxel/server dev\" \"pnpm --filter @voxel/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "voice:setup": "node scripts/setup-local-voice.mjs",
    "db:start": "node scripts/database.mjs",
    "db:stop": "node scripts/database.mjs stop",
    "db:generate": "pnpm --filter @voxel/server exec prisma generate",
    "db:migrate": "pnpm --filter @voxel/server exec dotenv -e ../../.env -- prisma migrate deploy",
    "agent": "pnpm --filter @voxel/agent-cli start",
    "agent:ai": "pnpm --filter @voxel/agent-cli start:ai",
    "agent:mock": "pnpm --filter @voxel/agent-cli start:mock",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:integration": "pnpm --filter @voxel/agent-cli test:integration",
    "format": "prettier --write apps packages scripts tests README.md docs package.json tsconfig.json pnpm-workspace.yaml",
    "format:check": "prettier --check apps packages scripts tests README.md docs package.json tsconfig.json pnpm-workspace.yaml",
    "test:agent:deepseek": "pnpm --filter @voxel/server test:agent:deepseek",
    "test:agents": "pnpm --filter @voxel/server exec tsx test/integration/agent-management.ts",
    "test:chat": "pnpm --filter @voxel/server exec tsx test/integration/chat.ts",
    "test:player:names": "pnpm --filter @voxel/server exec tsx test/integration/player-names.ts",
    "test:agent:voice": "pnpm --filter @voxel/server exec tsx test/integration/agent-speech.ts",
    "test:voice:live": "pnpm --filter @voxel/server exec tsx test/integration/live-speech.ts",
    "test:voice:services": "pnpm --filter @voxel/server exec tsx test/integration/voice-services.ts",
    "test:agent:tasks": "pnpm --filter @voxel/server exec tsx test/integration/agent-tasks.ts",
    "test:navigation": "pnpm --filter @voxel/server exec tsx test/integration/navigation.ts",
    "bench:navigation": "tsx tests/benchmarks/navigation.ts",
    "test:navigation:live": "pnpm --filter @voxel/server exec tsx test/integration/navigation-live-model.ts",
    "agent:ctl": "pnpm --filter @voxel/agent-cli ctl",
    "test:gateway": "pnpm --filter @voxel/server exec tsx test/integration/gateway.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@voxel/agent-runtime": "workspace:*",
    "@voxel/agent-orchestrator": "workspace:*",
    "@voxel/agent-gateway": "workspace:*",
    "@voxel/gateway-protocol": "workspace:*",
    "@voxel/gateway-client": "workspace:*"
  }
}
